{
  "expo": {
    "name": "Teamder",
    "slug": "soccer-game",
    "version": "1.1.66",
    "orientation": "portrait",
    "icon": "./Logo.png",
    "scheme": [
      "footy",
      "teamder",
      "com.studiogameslime.soccerapp"
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studiogameslime.soccerapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:teamderfc.web.app",
        "applinks:teamder.co.il",
        "applinks:www.teamder.co.il"
      ],
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he",
          "en"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ],
        "NSLocationWhenInUseUsageDescription": "Teamder משתמשת במיקום שלך כדי להציג קהילות וכדורגל באזור שלך. אפשר תמיד לסנן ידנית לפי עיר במקום.",
        "NSPhotoLibraryUsageDescription": "Teamder מבקשת גישה לתמונות שלך כדי שתוכל להעלות אווטאר אישי או תמונת קאבר לקהילה שלך.",
        "NSCameraUsageDescription": "Teamder מבקשת גישה למצלמה כדי לצלם אווטאר אישי בלי לעזוב את האפליקציה.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Logo.png",
        "backgroundColor": "#1E40AF"
      },
      "package": "com.studiogameslime.soccerapp",
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "teamderfc.web.app",
              "pathPrefix": "/session"
            },
            {
              "scheme": "https",
              "host": "teamderfc.web.app",
              "pathPrefix": "/team"
            },
            {
              "scheme": "https",
              "host": "teamderfc.web.app",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "teamderfc.web.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "teamderfc.web.app",
              "pathPrefix": "/go"
            },
            {
              "scheme": "https",
              "host": "teamderfc.web.app",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "teamder.co.il",
              "pathPrefix": "/session"
            },
            {
              "scheme": "https",
              "host": "teamder.co.il",
              "pathPrefix": "/team"
            },
            {
              "scheme": "https",
              "host": "teamder.co.il",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "teamder.co.il",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "teamder.co.il",
              "pathPrefix": "/go"
            },
            {
              "scheme": "https",
              "host": "teamder.co.il",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "www.teamder.co.il",
              "pathPrefix": "/session"
            },
            {
              "scheme": "https",
              "host": "www.teamder.co.il",
              "pathPrefix": "/team"
            },
            {
              "scheme": "https",
              "host": "www.teamder.co.il",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "www.teamder.co.il",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "www.teamder.co.il",
              "pathPrefix": "/go"
            },
            {
              "scheme": "https",
              "host": "www.teamder.co.il",
              "pathPrefix": "/c/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.BODY_SENSORS_BACKGROUND",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SPEED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE"
      ]
    },
    "plugins": [
      "./plugins/withStoreUpdate.js",
      "./plugins/withNotificationColorMerge.js",
      "./plugins/withLegacyBackHandling.js",
      "expo-localization",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.559368532219-t9g2eli4n5l9tstsv10sibv7i8tbv0km"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./Logo.png",
          "color": "#1E40AF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "כדי להציג קבוצות כדורגל בקרבת מקום ולעזור לסנן לפי 'קרוב אליי'.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4452511612073107~1968239705",
          "iosAppId": "ca-app-pub-4452511612073107~1657350145",
          "skAdNetworkItems": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "./plugins/withIoniconsAsset.js",
      "./plugins/withScreenCapture.js",
      "./plugins/withWearApp.js",
      "./plugins/withFmtConstevalFix.js",
      "./plugins/withRemoveAlwaysLocation.js",
      "./plugins/withJoryioSdk.js",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withAuthBackupExclusions.js",
      "./plugins/withHealth.js",
      "./plugins/withPhoneActivity.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "382fd359-9632-4210-ad26-fb967a8a893a"
      }
    },
    "owner": "studiogameslimes-organization"
  }
}
