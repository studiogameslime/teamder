<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the Teamder players-list widget. Taller
  than the timer widget (3×3 instead of 3×2) because it shows a
  scrollable roster — more vertical real estate is genuinely useful.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_players"
    android:previewLayout="@layout/widget_players_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
