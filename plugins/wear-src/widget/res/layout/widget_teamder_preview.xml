<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview-only layout for the widget picker. Hard-codes a sample paused
  state — title + frozen time + play & reset buttons — so the user sees
  the most visually-rich variant of the widget (showing the controls
  they'll actually interact with).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center"
    android:background="@drawable/widget_bg">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="Teamder"
        android:src="@drawable/teamder_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teamder"
        android:textColor="#1F2A44"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:34"
        android:textColor="#1E40AF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_play_bg"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_reset_bg"
            android:gravity="center"
            android:text="↻"
            android:textColor="#1E40AF"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
