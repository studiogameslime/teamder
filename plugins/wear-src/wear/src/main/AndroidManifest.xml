<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Reads the live-match doc + user games over the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ongoing Activity notification for a running live-match timer (Wear
         App Quality requirement — watch-face indicator + recents chip). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Declared to match the app-level "uses advertising ID" declaration
         in Play Console (the phone app uses AdMob). The watch shows no ads
         and never reads the ad id, but the artifact must carry the
         permission so it's consistent with the app declaration. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Wear Health Services match recording (health/ExerciseRecorderService).
         These are the NORMAL sensor runtime permissions — NOT the
         android.permission.health.* Health-Connect permissions — so they do
         NOT trigger Google Play's Health-apps declaration gate. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- NOTE: no ACCESS_FINE_LOCATION — GPS is off (setIsGpsEnabled(false)) so we
         avoid Google Play's Location-permission declaration gate. Distance is
         step-derived. -->
    <!-- Foreground service so the exercise keeps recording with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!-- Marked standalone so testers can install it directly from the
             Play Store ON THE WATCH (a dependent app is only auto-delivered
             with the phone app, which is unreliable during testing). It is
             still a thin client at runtime: it pulls live data from the
             paired phone via the Data Layer and shows a "open the app on
             your phone" state until that data arrives. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Adaptive Wear Tile — live timer / next game / no-game placeholder.
             Reads from the same /teamder/state DataItem the watch app
             consumes, so it stays in lockstep with the in-app state. -->
        <service
            android:name=".tile.TeamderTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_wear_foreground"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- Tile-picker preview. Re-using the brand logo here keeps
                 the wear module from needing a separate preview asset. -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/teamder_logo" />
        </service>

        <!-- Listens for /teamder/state changes and pushes a tile refresh.
             Without it the tile would only refresh on its declared
             freshness interval (~60s), and a start/pause on the phone
             would look frozen on the tile. -->
        <service
            android:name=".tile.TileUpdateListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/teamder/state" />
            </intent-filter>
        </service>

        <!-- Records the live match with Health Services (own sensors). Not
             exported: started only by our own PhysicalStateListenerService /
             MainActivity. type=health so it can hold the exercise foreground. -->
        <service
            android:name=".health.ExerciseRecorderService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Starts/stops the recorder off the phone's /teamder/state publishes,
             even while the watch app is closed (Play Services binds it). -->
        <service
            android:name=".health.PhysicalStateListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/teamder/state" />
            </intent-filter>
        </service>
    </application>
</manifest>
