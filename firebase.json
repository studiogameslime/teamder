{
  "react-native": {
    "crashlytics_auto_collection_enabled": true,
    "crashlytics_debug_enabled": false,
    "crashlytics_is_error_generation_on_js_crash_enabled": false,
    "crashlytics_javascript_exception_handler_chaining_enabled": true,
    "crashlytics_ndk_enabled": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "site": "teamderfc",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/play/**",
          "function": {
            "functionId": "serveAdLink",
            "region": "us-central1"
          }
        },
        {
          "source": "/session/**",
          "destination": "/invite.html"
        },
        {
          "source": "/app",
          "destination": "/invite.html"
        },
        {
          "source": "/go",
          "destination": "/invite.html"
        },
        {
          "source": "/track-click",
          "function": {
            "functionId": "trackLinkClick",
            "region": "us-central1"
          }
        },
        {
          "source": "/invite-preview",
          "function": {
            "functionId": "getInvitePreview",
            "region": "us-central1"
          }
        },
        {
          "source": "/team/**",
          "function": {
            "functionId": "serveCommunityPage",
            "region": "us-central1"
          }
        },
        {
          "source": "/c/**",
          "function": {
            "functionId": "serveCommunityPage",
            "region": "us-central1"
          }
        },
        {
          "source": "/i/**",
          "function": {
            "functionId": "serveInviteCode",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    },
    {
      "site": "soccer-app-52b6b",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/play/**",
          "function": {
            "functionId": "serveAdLink",
            "region": "us-central1"
          }
        },
        {
          "source": "/session/**",
          "destination": "/invite.html"
        },
        {
          "source": "/app",
          "destination": "/invite.html"
        },
        {
          "source": "/go",
          "destination": "/invite.html"
        },
        {
          "source": "/track-click",
          "function": {
            "functionId": "trackLinkClick",
            "region": "us-central1"
          }
        },
        {
          "source": "/invite-preview",
          "function": {
            "functionId": "getInvitePreview",
            "region": "us-central1"
          }
        },
        {
          "source": "/team/**",
          "function": {
            "functionId": "serveCommunityPage",
            "region": "us-central1"
          }
        },
        {
          "source": "/c/**",
          "function": {
            "functionId": "serveCommunityPage",
            "region": "us-central1"
          }
        },
        {
          "source": "/i/**",
          "function": {
            "functionId": "serveInviteCode",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
