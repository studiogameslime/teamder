rules_version = '2';

// Firebase Storage rules.
//
// Posture: deny by default. The only legitimate write paths are the
// per-user avatar slot and the per-community cover photo (coach-only).
// Everything else is closed.
//
// Hardening done in this audit:
//   • Filename pinned to `avatar.jpg` (was `{fileName}` — the wildcard
//     let an attacker turn their own /users/{uid}/ folder into free
//     image hosting by uploading hundreds of files).
//   • Size cap dropped from 5 MB → 1 MB. The client pipeline emits
//     a 512×512 JPEG @ 80% which lands at ≈150 KB; the 1 MB ceiling
//     leaves headroom while killing abusive uploads at the perimeter.
//   • Content-type check kept (image/*) — note this is client-supplied
//     so it's a perimeter signal, not authoritative malware screening.
//     Combined with the size cap and image extension it's good enough
//     for a profile avatar.
//   • Reads require auth (no public bucket browsing).
service firebase.storage {
  match /b/{bucket}/o {
    // Per-user avatar — the ONLY write path. Anyone signed-in can
    // read so feeds / player cards can display the photo.
    match /users/{userId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024
        // Allow only raster image formats. `image/.*` would also
        // match `image/svg+xml`, which can carry executable JS in
        // <script> tags — harmless inside RN's <Image>, but if a
        // share-preview ever renders the avatar in a WebView the
        // SVG would execute. Tightening to JPEG/PNG/WEBP closes
        // that vector with no UX cost (the upload pipeline emits
        // JPEG anyway).
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Anything else under /users/{userId}/ is closed. Defends against
    // the legacy "use my avatar folder as free image hosting" abuse
    // and pre-empts any future feature accidentally writing the wrong
    // path.
    match /users/{userId}/{rest=**} {
      allow read, write: if false;
    }

    // Community cover photo — full-bleed hero on the community details
    // screen. Anyone signed-in can read (the cover is shown to members,
    // visitors, and the public showcase). Only a COACH of the group may
    // write, verified by reading the canonical /groups/{groupId} doc
    // and checking adminIds — Storage rules can query Firestore via
    // firestore.get(). Filename pinned to cover.jpg (no wildcard) so a
    // compromised admin can't turn the folder into free image hosting.
    // 2 MB cap: the client pipeline emits a 1280×720 JPEG (~250 KB), so
    // this is generous headroom while still killing abusive uploads.
    match /groups/{groupId}/cover.jpg {
      allow read: if request.auth != null;
      // Client writes are disabled: the admin-check rule below used
      // `firestore.get(...).adminIds`, but a cross-service read from a
      // Storage rule carries no App Check token, and this project
      // enforces App Check on Firestore — so the get() failed and even
      // legitimate admins got `storage/unauthorized`. Cover uploads now
      // go through the `uploadGroupCover` callable, which verifies the
      // admin and writes via the Admin SDK (bypasses rules). Direct
      // client writes are therefore closed.
      allow write: if false;
    }

    // Everything else under /groups/{groupId}/ is closed.
    match /groups/{groupId}/{rest=**} {
      allow read, write: if false;
    }

    // Catch-all: every other path is denied for both reads and writes.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
