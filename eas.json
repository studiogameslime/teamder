{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production-wear": {
      "extends": "production",
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "android/wear/build/outputs/bundle/release/wear-release.aab"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_AFTER_CREATING_APP_IN_ASC",
        "appleTeamId": "REPLACE_AFTER_ENROLLMENT_APPROVED"
      }
    }
  }
}
