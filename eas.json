{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios-simulator": {
      "extends": "preview",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      }
    },
    "production-wear": {
      "extends": "production",
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "android/wear/build/outputs/bundle/release/wear-release.aab"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "studiogameslime@gmail.com",
        "ascAppId": "6775178022",
        "appleTeamId": "M7R8M498Z9"
      }
    }
  }
}
