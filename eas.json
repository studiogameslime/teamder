{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios-simulator": {
      "extends": "preview",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      }
    },
    "production-wear": {
      "extends": "production",
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "android/wear/build/outputs/bundle/release/wear-release.aab"
      }
    },
    "production-ios-local": {
      "extends": "production",
      "credentialsSource": "local"
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "ascAppId": "6775178022",
        "appleTeamId": "M7R8M498Z9",
        "ascApiKeyPath": "/Users/matan/.teamder-update-watch/AuthKey_SQBY46Q3DC.p8",
        "ascApiKeyId": "SQBY46Q3DC",
        "ascApiKeyIssuerId": "0938f882-34aa-42d5-af5d-cab509cac969"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/gplay-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6775178022",
