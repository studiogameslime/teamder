{
  "name": "footy-functions",
  "private": true,
  "description": "Cloud Functions for the Footy app — push notification consumer.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "node scripts/copy-template.js && tsc",
    "build:watch": "tsc --watch",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@types/jsrsasign": "^10.5.15",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "jsrsasign": "^11.1.3"
  },
  "devDependencies": {
    "@hebcal/core": "^6.8.2",
    "typescript": "^5.4.5"
  },
  "version": "1.0.0"
}
