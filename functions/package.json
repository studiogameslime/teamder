{
  "name": "footy-functions",
  "private": true,
  "description": "Cloud Functions for the Footy app — push notification consumer.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "node scripts/copy-template.js && tsc",
    "build:watch": "tsc --watch",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "^16.1.2",
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^5.1.1",
    "expo": "~53.0.27",
    "react": "19.0.0",
    "react-native": "0.79.6"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "version": "1.0.0"
}
