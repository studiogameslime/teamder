{
  "name": "@joryio/react-native-sdk",
  "version": "1.2.0",
  "description": "Joryio SDK for React Native - bridges native iOS and Android SDKs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src/",
    "ios/",
    "android/",
    "joryio-react-native.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "build": "tsc",
    "typescript": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "react-native",
    "joryio",
    "marketing",
    "analytics",
    "push-notifications",
    "in-app-messaging"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "typescript": "^5.0.0"
  }
}
