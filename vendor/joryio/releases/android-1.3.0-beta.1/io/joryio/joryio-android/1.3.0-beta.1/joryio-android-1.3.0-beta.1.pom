  <modelVersion>4.0.0</modelVersion>
  <groupId>io.joryio</groupId>
  <artifactId>joryio-android</artifactId>
  <version>1.3.0-beta.1</version>
  <packaging>aar</packaging>
  <name>Joryio Android SDK</name>
  <description>Joryio SDK for Android: identity, event tracking, push notifications and in-app message sync. No UI.</description>
  <url>https://github.com/joryio/joryio-android-sdk</url>
  <licenses>
    <license>
      <name>Joryio SDK Commercial License</name>
      <url>https://github.com/joryio/joryio-android-sdk/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>joryio</id>
      <name>Joryio</name>
      <email>support@joryio.com</email>
      <organization>Joryio</organization>
      <organizationUrl>https://joryio.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/joryio/joryio-android-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/joryio/joryio-android-sdk.git</developerConnection>
    <url>https://github.com/joryio/joryio-android-sdk</url>
  </scm>
